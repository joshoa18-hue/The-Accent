# Environment variables for The Ascent.
#
# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored. Never commit real keys, and never put a key in
# this file.
#
# None of these use the NEXT_PUBLIC_ prefix: all Supabase calls happen on the
# server, so the values are never sent to the browser.

# Local stack: run `npm run db:start`, then `npm run db:status` shows both.
# Hosted (Vercel → Settings → Environment Variables): the values from
# Supabase → Project Settings → API, e.g. https://<project-ref>.supabase.co
# See docs/DEPLOYMENT.md.
SUPABASE_URL=http://127.0.0.1:55321
# Must be the PUBLISHABLE key (sb_publishable_…). The app refuses secret keys.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Development only: the local mail catcher that receives sign-in emails.
# Don't set this in production (it's ignored outside `npm run dev` anyway).
DEV_MAILBOX_URL=http://127.0.0.1:55324

# The secret / service-role key bypasses Row Level Security. The web app does
# not use it. Never add it here or to .env.local.
