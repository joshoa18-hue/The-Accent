# Environment variables for The Ascent.
#
# Milestone 1 needs NONE of these: the app runs entirely on sample data.
# They are listed so Milestone 2 (Supabase) has a documented starting point.
#
# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored. Never commit real keys, and never put a key in
# this file.

# Public: safe in the browser. Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import it from client code, and avoid using it in the web app at all
# unless an admin-only task truly requires it.
# SUPABASE_SERVICE_ROLE_KEY=
